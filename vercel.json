{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/slides", "destination": "/deck", "permanent": false },
    { "source": "/playground", "destination": "/quickstart", "permanent": false },
    { "source": "/docs", "destination": "/quickstart", "permanent": false }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
